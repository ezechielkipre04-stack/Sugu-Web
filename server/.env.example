# Serveur SUGU — API complète (auth, catalogue, commandes, KYC, OTP)
PORT=4000

# Origines autorisées pour le CORS, séparées par des virgules.
# En production : https://app.sugu.ci
APP_ORIGIN=http://localhost:4000

# À passer sur true uniquement derrière un reverse proxy de confiance
# (Railway, Render, Nginx…), pour lire x-forwarded-for et x-forwarded-proto.
TRUST_PROXY=false

# --- Sécurité ---
# Secret de signature des codes, des jetons de vérification et des URLs KYC.
# Générez une valeur longue et aléatoire en production.
OTP_SECRET=change-me-with-a-long-random-secret

# Durée d’une session (jours).
SESSION_TTL_DAYS=30

# --- Codes de vérification ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Affiche le code dans la réponse API et dans la console du serveur.
# À laisser sur false en production.
OTP_DEBUG=true

# Indicatif utilisé pour les numéros saisis sans indicatif (Côte d’Ivoire).
DEFAULT_COUNTRY_CODE=225

# --- Stockage ---
# Par défaut : server/data/sugu.db et server/data/kyc (relatifs à server/).
# Décommentez uniquement pour choisir un autre emplacement.
# En production, utilisez un volume persistant et des chemins absolus.
# DB_PATH=/var/lib/sugu/sugu.db
# KYC_DIR=/var/lib/sugu/kyc

# Taille maximale d’une image KYC (octets) et d’un corps JSON.
MAX_UPLOAD_BYTES=4194304
MAX_JSON_BYTES=20000000

# Remplit la base avec les données de démonstration au premier lancement.
# À passer sur false en production.
DEMO_SEED=true

# En démonstration, un dossier KYC envoyé est automatiquement marqué « vérifié »
# pour permettre de tester la commande sans interface d’administration.
# À passer sur false en production.
AUTO_VERIFY_KYC=true

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=sugu_verification
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_API_VERSION=v22.0

# --- SMS de secours ---
# twilio ou termii
SMS_PROVIDER=twilio

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

TERMII_API_KEY=
TERMII_SENDER_ID=SUGU
